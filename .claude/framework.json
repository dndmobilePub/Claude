      ".claude/hooks/**",
      ".claude/scripts/**",
      ".claude/skills/**",
      ".github/pull_request_template.md",
      "templates/**"
    ],
    "병합": [
      ".claude/rules/a11y.md",
      ".claude/rules/figma-design-system.md",
      "docs/ARCHITECTURE.md",
